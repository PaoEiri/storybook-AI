# ===========================================
# CONFIGURACIÓN DE PROVEEDORES
# ===========================================

# Proveedor de LLM (texto + visión + streaming): gemini | openai
LLM_PROVIDER=openai

# Proveedor de generación de imágenes: huggingface | pollinations | openai
IMAGE_PROVIDER=openai

# ===========================================
# API KEYS - GRATUITAS (actuales)
# ===========================================

# Gemini: https://aistudio.google.com/app/apikey 
GEMINI_API_KEY=key
# Opcional: modelo de Gemini a usar (Google rota modelos con frecuencia).

GEMINI_MODEL=gemini-3.5-flash



# ===========================================
# API KEYS - OPENAI (cuando hay acceso)
# ===========================================
OPENAI_API_KEY=tu_openai_key_aqui

# ===========================================
# CONFIGURACIÓN GENERAL
# ===========================================

# Número máximo de imágenes por historia (no tocar, restricción de la tarea)
MAX_IMAGES=3

# Número de turnos interactivos antes del cierre
MAX_TURNS=2
